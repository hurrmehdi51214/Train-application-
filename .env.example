# ---------------------------------------------------------------------------
# Client configuration. Everything with an EXPO_PUBLIC_ prefix is compiled into
# the app bundle and is readable by anyone who downloads it, so no secret can
# ever go in this file. Server secrets live in server/.env.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_API_BASE_URL=https://api.safar.pk/v1
EXPO_PUBLIC_REALTIME_URL=wss://realtime.safar.pk/v1/stream
EXPO_PUBLIC_INSTALL_URL=https://get.safar.pk

# Runs the app against the bundled Pakistan Railways timetable. Set to false to
# talk to a real gateway.
EXPO_PUBLIC_USE_FIXTURES=true

# ---------------------------------------------------------------------------
# Google Maps
# ---------------------------------------------------------------------------
# CLIENT key, for drawing maps only. This one ships in the bundle, which is
# fine *provided* it is restricted in the Google Cloud console to:
#   - iOS: bundle id pk.safar.rail
#   - Android: package pk.safar.rail + your signing certificate SHA-1
#   - Web: your own HTTP referrers
# and has only "Maps SDK for Android", "Maps SDK for iOS" and "Maps JavaScript
# API" enabled on it. Never put a server key here.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Where Directions / Geocoding / Places are proxied. Leave blank to use the
# gateway's own /maps namespace. Those APIs are never called directly from the
# app - the key for them is a billable server key and stays on the server.
EXPO_PUBLIC_MAPS_PROXY_URL=
