{
  "expo": {
    "name": "Safar",
    "slug": "safar-rail",
    "version": "1.0.0",
    "scheme": "safar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7A3A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.safar.rail",
      "config": {
        "usesNonExemptEncryption": false,
        "googleMapsApiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Safar uses your location to show the walk to your station and to track your train in real time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Background location lets Safar tell you when your stop is approaching, even with the screen off.",
        "UIBackgroundModes": ["location", "remote-notification"],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "pk.safar.rail",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7A3A"
      },
      "config": {
        "googleMaps": {
          "apiKey": "$EXPO_PUBLIC_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Safar uses your location to guide you to your platform and to alert you before your stop.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E7A3A",
          "defaultChannel": "journey"
        }
      ]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiBaseUrl": "https://api.safar.pk/v1",
      "realtimeUrl": "wss://realtime.safar.pk/v1/stream",
      "installUrl": "https://get.safar.pk",
      "mapsProxyUrl": ""
    }
  }
}
