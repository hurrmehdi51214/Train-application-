# Client (read through expo-constants / EXPO_PUBLIC_*)
EXPO_PUBLIC_API_BASE_URL=https://api.meridianrail.example/v1
EXPO_PUBLIC_REALTIME_URL=wss://realtime.meridianrail.example/v1/stream
EXPO_PUBLIC_INSTALL_URL=https://install.meridianrail.example

# Never put secrets in EXPO_PUBLIC_* — they ship inside the app bundle.
# Server secrets live in server/.env (see server/.env.example).
