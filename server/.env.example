# ---------------------------------------------------------------------------
# Gateway configuration. Copy to server/.env. Never commit the filled-in file.
# ---------------------------------------------------------------------------

PORT=8080
NODE_ENV=development

# Existing train system database.
# Point this at a READ REPLICA. The gateway must never be able to write to the
# operator's system of record; see docs/ARCHITECTURE.md.
RAIL_DB_HOST=replica.pakrail.internal
RAIL_DB_PORT=5432
RAIL_DB_NAME=prits
RAIL_DB_USER=safar_gateway_ro
RAIL_DB_PASSWORD=
RAIL_DB_SSL_MODE=verify-full
RAIL_DB_SSL_ROOT_CERT=/etc/ssl/pakrail-internal-ca.pem
RAIL_DB_MAX_CONNECTIONS=10
RAIL_DB_STATEMENT_TIMEOUT_MS=4000

# Gateway's own store (tickets, orders, devices). Separate database, read-write.
GATEWAY_DB_URL=postgres://safar:@localhost:5432/safar_gateway

# Ticket signing. In production the private key lives in an HSM/KMS and this
# variable holds only the key's identifier; ED25519_PRIVATE_KEY_PEM is for local
# development and CI only.
TICKET_SIGNING_KEY_ID=sfr-2026-01
TICKET_SIGNING_KMS_URI=
ED25519_PRIVATE_KEY_PEM=

# Access tokens
JWT_ISSUER=https://auth.safar.pk
JWT_AUDIENCE=safar-mobile
JWT_PUBLIC_KEY_PEM=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------------
# Google Maps (server key)
# ---------------------------------------------------------------------------
# Billable, and NOT restrictable by bundle id or referrer - so it lives here and
# never in the app. Enable only: Directions API, Geocoding API, Places API,
# Distance Matrix API. Restrict it by IP to this gateway's egress addresses.
# Leave blank to disable /v1/maps/*; the app then uses its bundled vector
# geometry, which is a supported mode rather than a failure.
GOOGLE_MAPS_SERVER_KEY=
